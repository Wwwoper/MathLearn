```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.css.map

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temp files
*.tmp

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled files
*.o
*.obj
*.so
*.a
*.dll
*.exe
*.out

# Coverage
coverage/
htmlcov/
.coverage

# Caches
.mypy_cache/
.pytest_cache/
.gradle/
target/

# System files
.DS_Store
Thumbs.db
```